NODE_ENV=development

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

BASE_URL=https://web.telegram.org/a/

# Gateway mode (variant 2): embed the fork in the platform iframe and talk to our WS gateway.
# Off unless TG_GATEWAY=1. Origins are a comma-separated allowlist of trusted platform origins.
TG_GATEWAY=1
TG_GATEWAY_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
